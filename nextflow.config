// nextflow.config -- container and profile settings only. Default parameter
// values live in params.yaml, loaded explicitly:
//
//   nextflow run . -params-file params.yaml --sample_sheet sheet.csv \
//       --data_dir /path/to/data --output_dir /path/to/output [-profile apptainer]
//
// No executor settings live here either. On a cluster, pass your own site
// config with `-c site.config` (executor, queue, per-label cpus/memory/time,
// apptainer cache dir) -- see README.md for an example.
//
// Don't add an empty top-level `params {}` block: combined with
// -params-file it made Nextflow <26 misattribute every params.yaml key into
// the process scope ("Unknown config attribute `params`").

docker {
    enabled = true
    // Run as the invoking user, so published outputs aren't root-owned.
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    container = params.container_image

    // ARCHIVE_FASTQ moves host files in place: no container, so it sees
    // the real data and completed_fastqs directories.
    withName: 'ARCHIVE_FASTQ' {
        container = null
    }
}

profiles {
    // Run every task in the image through Apptainer instead of Docker --
    // the usual choice on an HPC cluster. It runs the same docker:// image.
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    // No container at all: every task runs in the invoking environment
    // (this repo's own uv venv, plus pacybara_simplex.sh on PATH). What the
    // integration suite uses, with a stub pacybara_simplex.sh.
    local {
        docker.enabled = false
        process.container = null
    }
}
